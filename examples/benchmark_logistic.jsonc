{
  // --- System parameters ---
  "a": 2.0,                  // logistic map parameter (fully developed chaos)

  // --- Trajectory ---
  "N": 50000,                // number of iterations
  "n_transient": 5000,       // transient to discard
  "x0": 0.1,                 // initial condition

  // --- Lyapunov ---
  "lyap_n_iter": 200000,     // iterations for exponent
  "lyap_n_transient": 10000, // transient for exponent

  // --- Embedding ---
  "tau_max": 5,              // max delay for AMI (small for maps)
  "d_max": 10,               // max embedding dimension
  "n_r": 50,                 // number of r values for D2

  // --- Reference values ---
  "ref_lambda1": 0.6931471805599453,  // ln(2), exact for a=2
  "ref_D2": 1.0              // exact, conjugacy to Bernoulli shift
}
