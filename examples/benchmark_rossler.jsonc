{
  // --- System parameters (fixed in rossler_rhs) ---
  // a = 0.2, b = 0.2, c = 5.7

  // --- Trajectory ---
  "t_span": [0, 2000],       // integration interval (Rossler is slow)
  "dt": 0.05,                // time step
  "t_transient": 200.0,      // transient to discard

  // --- Lyapunov ---
  "lyap_x0": [1.0, 1.0, 0.0],       // initial condition for spectrum
  "lyap_t_total": 1000.0,            // total time for spectrum
  "lyap_dt": 0.01,                   // time step for spectrum
  "lyap_t_transient": 200.0,         // transient for spectrum
  "reorth_dt": 1.0,                  // reorthogonalization interval

  // --- Embedding ---
  "subsample": 2,            // take every Nth point (dt_eff = 0.1)
  "tau_max": 100,            // max delay for AMI
  "d_max": 12,               // max embedding dimension
  "n_r": 50,                 // number of r values for D2

  // --- Reference values ---
  "ref_lambda1": 0.0714,     // Sprott (2003)
  "ref_spectrum": [0.0714, 0.0, -5.39],
  "ref_D2": 2.01             // Sprott & Rowlands (2001), IJBC 11, 1865-1880
}
