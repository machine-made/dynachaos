{
  // Reproducible CI-sized scale-envelope benchmark.  Full mode is local-only.
  "mode": "ci",
  "seed": 20260610,
  "repeats": 3,
  "gp": {
    "embedding_dim": 3,
    "delay": 1,
    "radius_count": 12,
    "theiler_window": 1,
    "norm": "chebyshev",
    "ci_lengths": [300, 600, 1000],
    "full_lengths": [1000, 3000, 10000, 30000, 100000],
    "python_ci_cap": 1000,
    "python_full_cap": 3000
  },
  "rqa": {
    "percentile": 5,
    "metric": "euclidean",
    "l_min": 2,
    "v_min": 2,
    "ci_lengths": [100, 200, 350],
    "full_lengths": [500, 1000, 2000, 4000, 8000, 16000],
    "stop_predicted_bytes": 4294967296
  },
  "signals": {
    "logistic_a": 1.99,
    "cml_a": 1.72,
    "cml_eps": 0.4,
    "cml_sites": 64,
    "burn_in": 500
  },
  "output": {
    "json": "benchmarks/results/scale_envelope.json",
    "markdown": "benchmarks/results/scale_envelope.md"
  }
}
